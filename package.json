{
  "name": "docia-lab-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DOCIA Lab public website, built from structured content.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:content": "node scripts/validate-content.js",
    "build:content": "node scripts/build-content.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "test": "node --test test/*.test.js",
    "deploy:server": "bash tools/deploy-server.sh",
    "deploy:remote": "bash tools/deploy-remote.sh"
  },
  "dependencies": {
    "@retorquere/bibtex-parser": "14.0.8",
    "ajv": "8.17.1",
    "marked": "18.3.0",
    "yaml": "2.9.1"
  }
}
