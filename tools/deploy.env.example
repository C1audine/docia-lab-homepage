# 远程部署配置示例（tools/deploy.env.example）
#
# 用法：
#   1. 复制为 tools/deploy.env：cp tools/deploy.env.example tools/deploy.env
#   2. 按需修改（真实主机信息只放在 deploy.env，不要提交）
#   3. tools/deploy.env 已在 .gitignore 中；本示例文件只含占位符。
#
# 优先级：命令行参数 > 同名环境变量 > tools/deploy.env > 脚本默认值。
# 变量含义见 docs/DEPLOYMENT.md 的“配置项”一节。

# 服务器地址或域名（必填；占位符，请替换为你的主机）
DEPLOY_HOST=your-server.example.com

# SSH 登录用户（留空则沿用当前 ssh 配置/当前用户）
DEPLOY_USER=your-user

# SSH 端口
DEPLOY_PORT=22

# 远端站点目录：支持 ~/... 和绝对路径；~ 在远端解析，不是本机 home
DEPLOY_PATH=~/docia-site

# Nginx server_name；示例域名，请替换为实际域名
DEPLOY_DOMAIN=example.com

# Nginx listen 端口
DEPLOY_HTTP_PORT=80

# 1=部署前执行 npm run build；0=直接使用现有 dist/
DEPLOY_BUILD=1

# 1=首次部署走 sudo 初始化（暂存到远端 ~/.docia-deploy）
# 之后日常更新设为 0 即可
DEPLOY_BOOTSTRAP=0

# 额外 ssh 选项（默认已开启 accept-new 和 15s 连接超时）
# SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=15"
