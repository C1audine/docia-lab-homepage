{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "bilingualArray": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/bilingual" }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "externalUrl": {
      "type": "string",
      "pattern": "^(https?://|mailto:)",
      "minLength": 8
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    }
  }
}
